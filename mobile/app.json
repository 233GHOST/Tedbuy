{
  "expo": {
    "name": "TedBuy",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "tedbuy",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tedbuy.app",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.tedbuy.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "TedBuy needs access to your photos so you can add pictures to your listings."
        }
      ],
      "expo-video",
      [
        "expo-media-library",
        {
          "photosPermission": "TedBuy needs access to your photos so it can show your most recent photo/video as a quick-pick shortcut when posting a listing.",
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "TedBuy needs camera access so you can record a video for your listing.",
          "microphonePermission": "TedBuy needs microphone access to record audio with your listing video.",
          "recordAudioAndroid": true
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.735307724523-i66v0emjupugqgnd5voeptbjo8foqgev"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ac3cac35-c37c-46b9-883c-80dce6bdb13d"
      }
    },
    "owner": "233ghost"
  }
}
