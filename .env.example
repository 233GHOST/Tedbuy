# Paystack Gateway API Keys
# Server-side Secret Key (keep secure, never prefix with VITE_)
PAYSTACK_SECRET_KEY=

# Client-side Public Key (exposed to browser for loading payment popup)
VITE_PAYSTACK_PUBLIC_KEY=

# Scheduled Cron Trigger Security Secret
CRON_SECRET=

# Supabase (Option 4) Credentials
# Set these to activate the free, durable Supabase cloud database integration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Firebase Client-side Configuration (used for Render/Vercel deployment)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Brevo (Sendinblue) Transactional Email API Keys
# Server-side Secret API Key (never prefix with VITE_)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Cloudinary Storage Configuration (Zero Base64 Architecture)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_API_KEY=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Optional Custom Super-Administrator Security PIN (6 digits, defaults to hash of "559102")
VITE_ADMIN_PIN=

# GitHub Personal Access Token for remote repository synchronization
GITHUB_TOKEN=

# Google Gemini API Key — powers AI-generated listing descriptions
# (POST /api/ai/generate-listing-description). Server-only, never exposed to
# web or mobile clients. Without it, the endpoint returns 503 and sellers
# simply write their own description.
GEMINI_API_KEY=
# Optional: override the Gemini model used (defaults to gemini-2.0-flash)
GEMINI_MODEL=

# Android Direct-Download Release Config (single source of truth for /download)
# ANDROID_APK_URL is the CDN URL the /downloads/tedbuy.apk route redirects to.
# Leave unset to have /download render a "Coming Soon" state instead of a broken link.
ANDROID_APK_URL=
ANDROID_APP_VERSION=
ANDROID_APK_SIZE_MB=
ANDROID_APK_SHA256=
ANDROID_MIN_OS=
ANDROID_APK_RELEASE_DATE=
